	$(MAKE) $(MAKESILENT) -f CMakeFiles/OpenRPG_Editor.dir/build.make CMakeFiles/OpenRPG_Editor.dir/src/viewport.cpp.o
.PHONY : src/viewport.cpp.o

src/viewport.i: src/viewport.cpp.i
.PHONY : src/viewport.i

# target to preprocess a source file
src/viewport.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/OpenRPG_Editor.dir/build.make CMakeFiles/OpenRPG_Editor.dir/src/viewport.cpp.i
.PHONY : src/viewport.cpp.i

src/viewport.s: src/viewport.cpp.s
.PHONY : src/viewport.s

# target to generate assembly for a file
src/viewport.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/OpenRPG_Editor.dir/build.make CMakeFiles/OpenRPG_Editor.dir/src/viewport.cpp.s
.PHONY : src/viewport.cpp.s


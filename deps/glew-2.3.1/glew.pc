prefix=/usr/local
exec_prefix=${prefix}
libdir=/usr/local/x86_64-w64-mingw32/lib
includedir=${prefix}/include

Name: glew
Description: The OpenGL Extension Wrangler library
Version: 2.3.1
Cflags: -I${includedir} 
Libs: -L${libdir} -lglew32 -L/usr/x86_64-w64-mingw32/lib -lopengl32 -lgdi32 -luser32 -lkernel32
Requires: glu
